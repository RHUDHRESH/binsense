# sudo cp edge-jev.service /etc/systemd/system/ && sudo systemctl enable --now edge-jev
[Unit]
Description=Edge-Jev offline waste sorting service
After=local-fs.target

[Service]
User=pi
WorkingDirectory=/home/pi/jev
ExecStart=/home/pi/jev-venv/bin/python /home/pi/jev/service.py
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
